;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CalyrexMod Assets"
run/main_scene="res://assets/scenes/calyrex_merchant.tscn"
config/features=PackedStringArray("4.5", "C#")
config/icon="res://assets/icons/calyrex_icon.png"

[dotnet]

project/assembly_name="CalyrexModAssets"

[editor_plugins]

enabled=PackedStringArray()

[rendering]

renderer/rendering_method="mobile"
