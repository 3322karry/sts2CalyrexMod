{
  "DARV.talk.CALYREX_CHARACTER.0-0.ancient": "哦！！这不是我们的霜国王嘛！！",
  "DARV.talk.CALYREX_CHARACTER.0-0.next": "继续",
  "DARV.talk.CALYREX_CHARACTER.0-1.char": "[i][font_size=22]蕾冠王微微颔首，缰绳轻响。[/font_size][/i]",
  "DARV.talk.CALYREX_CHARACTER.0-1.next": "继续",
  "DARV.talk.CALYREX_CHARACTER.0-2.ancient": "王冠见过，缰绳也见过……同时握着的，你是头一个！！",
  "DARV.talk.CALYREX_CHARACTER.1-0r.ancient": "还活着呐！！马也还驮着你呐！！",
  "DARV.talk.CALYREX_CHARACTER.2-0.ancient": "有人在暗处数你的马蹄声呢！！",
  "DARV.talk.CALYREX_CHARACTER.2-0.next": "追问",
  "DARV.talk.CALYREX_CHARACTER.2-1.char": "[i][font_size=22]蕾冠王没有开口，缰绳却绷紧了。[/font_size][/i]",
  "DARV.talk.CALYREX_CHARACTER.2-1.next": "继续",
  "DARV.talk.CALYREX_CHARACTER.2-2.ancient": "哦豁，我可什么都没说！！等你过了下一层再来问我吧！！",
  "NONUPEIPE.talk.CALYREX_CHARACTER.0-0.ancient": "你身上有山的气息。",
  "NONUPEIPE.talk.CALYREX_CHARACTER.0-0.next": "继续",
  "NONUPEIPE.talk.CALYREX_CHARACTER.0-1.char": "[i][font_size=22]山从不高声说话。[/font_size][/i]",
  "NONUPEIPE.talk.CALYREX_CHARACTER.0-1.next": "继续",
  "NONUPEIPE.talk.CALYREX_CHARACTER.0-2.ancient": "所以山还立着。",
  "NONUPEIPE.talk.CALYREX_CHARACTER.1-0r.ancient": "又踩上了我的石头路。",
  "NONUPEIPE.talk.CALYREX_CHARACTER.2-0.ancient": "雾里有东西在学你的脚步声。",
  "NONUPEIPE.talk.CALYREX_CHARACTER.2-0.next": "继续",
  "NONUPEIPE.talk.CALYREX_CHARACTER.2-1.char": "[i][font_size=22]它学不会缰绳的响动。[/font_size][/i]",
  "NONUPEIPE.talk.CALYREX_CHARACTER.2-1.next": "继续",
  "NONUPEIPE.talk.CALYREX_CHARACTER.2-2.ancient": "那就让它学。",
  "OROBAS.talk.CALYREX_CHARACTER.0-0.ancient": "灵幽马的黑影比你先到。",
  "OROBAS.talk.CALYREX_CHARACTER.0-0.next": "继续",
  "OROBAS.talk.CALYREX_CHARACTER.0-1.char": "[i][font_size=22]影子先到，我随后就到。[/font_size][/i]",
  "OROBAS.talk.CALYREX_CHARACTER.0-1.next": "继续",
  "OROBAS.talk.CALYREX_CHARACTER.0-2.ancient": "那要看它愿不愿意等。",
  "OROBAS.talk.CALYREX_CHARACTER.1-0r.ancient": "影子又长了一寸。",
  "OROBAS.talk.CALYREX_CHARACTER.2-0.ancient": "你的另一匹马在冰里打了个寒颤。",
  "OROBAS.talk.CALYREX_CHARACTER.2-0.next": "继续",
  "OROBAS.talk.CALYREX_CHARACTER.2-1.char": "[i][font_size=22]冰从不怕冷。[/font_size][/i]",
  "OROBAS.talk.CALYREX_CHARACTER.2-1.next": "继续",
  "OROBAS.talk.CALYREX_CHARACTER.2-2.ancient": "怕冷的从来不是冰。",
  "PAEL.talk.CALYREX_CHARACTER.0-0.ancient": "王冠与缰绳，你犹豫了很久才一起拿起。",
  "PAEL.talk.CALYREX_CHARACTER.0-0.next": "继续",
  "PAEL.talk.CALYREX_CHARACTER.0-1.char": "[i][font_size=22]它们本是一套。[/font_size][/i]",
  "PAEL.talk.CALYREX_CHARACTER.0-1.next": "继续",
  "PAEL.talk.CALYREX_CHARACTER.0-2.ancient": "是一套。只是没人敢这么想。",
  "PAEL.talk.CALYREX_CHARACTER.1-0r.ancient": "同一套，再次同来。",
  "PAEL.talk.CALYREX_CHARACTER.2-0.ancient": "有人想拆散你和你的马。",
  "PAEL.talk.CALYREX_CHARACTER.2-0.next": "继续",
  "PAEL.talk.CALYREX_CHARACTER.2-1.char": "[i][font_size=22]试过的人都不在了。[/font_size][/i]",
  "PAEL.talk.CALYREX_CHARACTER.2-1.next": "继续",
  "PAEL.talk.CALYREX_CHARACTER.2-2.ancient": "倒也没说错。",
  "TANX.talk.CALYREX_CHARACTER.0-0.ancient": "你脚下的雪没有脚印。",
  "TANX.talk.CALYREX_CHARACTER.0-0.next": "继续",
  "TANX.talk.CALYREX_CHARACTER.0-1.char": "[i][font_size=22]雪太深，脚印被盖住了。[/font_size][/i]",
  "TANX.talk.CALYREX_CHARACTER.0-1.next": "继续",
  "TANX.talk.CALYREX_CHARACTER.0-2.ancient": "还是马驮着你，没让你落地？",
  "TANX.talk.CALYREX_CHARACTER.1-0r.ancient": "雪还是没脚印。",
  "TANX.talk.CALYREX_CHARACTER.2-0.ancient": "前方有个坑，坑底有东西在数你。",
  "TANX.talk.CALYREX_CHARACTER.2-0.next": "继续",
  "TANX.talk.CALYREX_CHARACTER.2-1.char": "[i][font_size=22]让它数。数到七，它就闭嘴。[/font_size][/i]",
  "TANX.talk.CALYREX_CHARACTER.2-1.next": "继续",
  "TANX.talk.CALYREX_CHARACTER.2-2.ancient": "它从没数到过七。",
  "TEZCATARA.talk.CALYREX_CHARACTER.0-0.ancient": "冰与影，你都握住了。",
  "TEZCATARA.talk.CALYREX_CHARACTER.0-0.next": "继续",
  "TEZCATARA.talk.CALYREX_CHARACTER.0-1.char": "[i][font_size=22]它们并不冲突。[/font_size][/i]",
  "TEZCATARA.talk.CALYREX_CHARACTER.0-1.next": "继续",
  "TEZCATARA.talk.CALYREX_CHARACTER.0-2.ancient": "不冲突的两种力量，通常指向同一个尽头。",
  "TEZCATARA.talk.CALYREX_CHARACTER.1-0r.ancient": "尽头还没到，你倒先回来了。",
  "TEZCATARA.talk.CALYREX_CHARACTER.2-0.ancient": "你的马在夜里嘶鸣了一声。",
  "TEZCATARA.talk.CALYREX_CHARACTER.2-0.next": "继续",
  "TEZCATARA.talk.CALYREX_CHARACTER.2-1.char": "[i][font_size=22]那是它在回应什么。[/font_size][/i]",
  "TEZCATARA.talk.CALYREX_CHARACTER.2-1.next": "继续",
  "TEZCATARA.talk.CALYREX_CHARACTER.2-2.ancient": "回应的是个不该醒的东西。",
  "VAKUU.talk.CALYREX_CHARACTER.0-0.ancient": "你带着两匹马穿过了一道窄门。",
  "VAKUU.talk.CALYREX_CHARACTER.0-0.next": "继续",
  "VAKUU.talk.CALYREX_CHARACTER.0-1.char": "[i][font_size=22]门够宽。[/font_size][/i]",
  "VAKUU.talk.CALYREX_CHARACTER.0-1.next": "继续",
  "VAKUU.talk.CALYREX_CHARACTER.0-2.ancient": "是马够听话。",
  "VAKUU.talk.CALYREX_CHARACTER.1-0r.ancient": "门后还是门。",
  "VAKUU.talk.CALYREX_CHARACTER.2-0.ancient": "最后那道门，只容一人一马通过。",
  "VAKUU.talk.CALYREX_CHARACTER.2-0.next": "继续",
  "VAKUU.talk.CALYREX_CHARACTER.2-1.char": "[i][font_size=22]它们会一个化成冰，一个化成影。[/font_size][/i]",
  "VAKUU.talk.CALYREX_CHARACTER.2-1.next": "继续",
  "VAKUU.talk.CALYREX_CHARACTER.2-2.ancient": "等你走完，再合回来。",
  "NEOW.talk.CALYREX_CHARACTER.0-0.ancient": "[sine]..雪.. 与影.. 都.. ...在你.. 手里....[/sine]",
  "NEOW.talk.CALYREX_CHARACTER.0-0.next": "继续",
  "NEOW.talk.CALYREX_CHARACTER.0-1.char": "[i][font_size=22]缰绳低鸣，应了一声。[/font_size][/i]",
  "NEOW.talk.CALYREX_CHARACTER.0-1.next": "继续",
  "NEOW.talk.CALYREX_CHARACTER.0-2.ancient": "[sine]..去吧.. ..王冠.. ..在.. ..塔顶....[/sine]",
  "NEOW.talk.CALYREX_CHARACTER.1-0r.ancient": "[sine]..依旧.. 一人.. ..两骑.. ...很好....[/sine]",
  "NEOW.talk.CALYREX_CHARACTER.2-0.ancient": "[sine]..有人.. 想.. ..拆散.. 你们....[/sine]",
  "NEOW.talk.CALYREX_CHARACTER.2-0.next": "继续",
  "NEOW.talk.CALYREX_CHARACTER.2-1.char": "[i][font_size=22]蕾冠王没有说话。两匹马同时扬起了蹄。[/font_size][/i]",
  "NEOW.talk.CALYREX_CHARACTER.2-1.next": "继续",
  "NEOW.talk.CALYREX_CHARACTER.2-2.ancient": "[sine]...很好....[/sine]"
}